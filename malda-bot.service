[Unit]
Description=Malda College Bot (aiogram) — notice monitor + routine
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=azureuser
Group=azureuser

WorkingDirectory=/home/azureuser/malda-college-notification-bot
EnvironmentFile=/home/azureuser/malda-college-notification-bot/.env
ExecStart=/home/azureuser/malda-college-notification-bot/venv/bin/python /home/azureuser/malda-college-notification-bot/malda_bot.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ReadWritePaths=/home/azureuser/malda-college-notification-bot

[Install]
WantedBy=multi-user.target
