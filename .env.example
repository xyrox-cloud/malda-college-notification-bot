# ============================================================
# Malda College Bot — environment variables
# Copy this file to .env and fill in real values.
# ============================================================

# --- Telegram ---
# Bot token from @BotFather (required)
BOT_TOKEN=123456789:ABCdefGhIjKlMnOpQrStUvWxYz

# Admin chat ID(s) — numeric Telegram user ID.
# Get yours from @userinfobot or via getUpdates.
# Multiple admins: separate with commas (ADMIN_CHAT_ID=111,222)
ADMIN_CHAT_ID=123456789

# --- Google Apps Script exec URLs (required for routine features) ---
# Open each Google Apps Script web app in your browser, copy the full
# https://script.google.com/macros/s/AKfyc.../exec URL.
ODD_ROUTINE_URL=https://script.google.com/macros/s/AKfycbxXXXXXXX/exec
EVEN_ROUTINE_URL=https://script.google.com/macros/s/AKfycbyXXXXXXX/exec
CALENDAR_URL=https://script.google.com/macros/s/AKfycbzXXXXXXX/exec

# --- Notice-board scraping ---
# Polling interval in seconds (default 300 = 5 min; minimum 30)
INTERVAL=300

# --- Routine behaviour ---
# Class slot duration in minutes (used by /r now and /r next).
# Default 60 — each routine row only stores a start hour, so we assume 1h slots.
SLOT_DURATION_MIN=60

# Auto-refresh cached sheet data every N hours (default 24; set 0 to disable)
SHEET_REFRESH_HOURS=24

# Broadcast rate-limiting delay between sends, in seconds.
# Telegram global limit ~30 msg/sec; 0.04 keeps us at ~25/sec.
BROADCAST_DELAY_SEC=0.04

# --- Storage paths (optional; defaults shown) ---
# DATA_DIR=/opt/malda-bot/data
# USERS_FILE=users.json
# SEEN_FILE=seen_notices.json

# --- Misc ---
# Timezone for "today"/"now" resolution (default Asia/Kolkata)
# TZ=Asia/Kolkata
# Log level: DEBUG / INFO / WARNING / ERROR
# LOG_LEVEL=INFO
